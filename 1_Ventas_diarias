# El siguiente código permite registrar las ventas
# del día en el archivo ventas.txt
id_venta = input("Id: ")
prod = input("Producto: ")
cant = input("Cantidad: ")
precio_unit = input("Precio Unitario: ")

with open ("ventas.txt", "a") as vent:
    vent.write(f"{id_venta},{prod},{cant},{precio_unit}\n")
